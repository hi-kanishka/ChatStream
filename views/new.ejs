<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create new chat</title>
    <link rel="stylesheet" href="/style2.css">
</head>
<body>
    <h2>Write new chat here</h2>
    <form action="/chats" method="post">
        <input type="text" name="from" placeholder="Your name">
        <textarea name="msg"  placeholder="Write your message here"></textarea>
        <input type="text" placeholder="Add reciever's name" name="to">
        <button type="submit">Create Chat</button>
    </form>
</body>
</html>